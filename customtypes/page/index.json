      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "page_header": {
              "type": "SharedSlice"
            },
            "feature": {
              "type": "SharedSlice"
            },
            "content_grid": {
              "type": "SharedSlice"
            },
            "team_grid": {
              "type": "SharedSlice"
            },
            "beliefs_list": {
              "type": "SharedSlice"
            },
            "rich_text": {
              "type": "SharedSlice"
            },
            "call_to_action": {
              "type": "SharedSlice"
            },
            "event_list": {
              "type": "SharedSlice"
            },
            "info_list": {
              "type": "SharedSlice"
            },
            "map_embed": {
              "type": "SharedSlice"
            },
            "image_poster": {
              "type": "SharedSlice"
            },
            "contact_form": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
# Copy to .env.local for development. Set the real values in the Netlify UI.
# Never commit .env or .env.local.

# ---- Prismic (Phase 3) ------------------------------------------------------
PRISMIC_REPOSITORY_NAME=9yoxbcr3
# Point a deploy preview at a Prismic environment (a clone of the repo used to
# trial model changes) without a code change. Leave unset for production.
NEXT_PUBLIC_PRISMIC_ENVIRONMENT=
# Only needed if the repository is set to private.
PRISMIC_ACCESS_TOKEN=
# Shared secret for the preview / revalidation webhook.
PRISMIC_WEBHOOK_SECRET=

# ---- Forms (Phase 5) --------------------------------------------------------
# Gmail app password — not the account password.
GMAIL_USER=
GMAIL_PASS=
CONTACT_FORM_RECIPIENT=
DONATE_FORM_RECIPIENT=

# reCAPTCHA v3. The site key is public; the secret key is not.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Analytics --------------------------------------------------------------
# GA4 measurement ID. Loaded only after the visitor accepts the consent banner;
# leave unset and neither the tag nor the banner appears.
NEXT_PUBLIC_GA_ID=G-6YS7D18ZT5

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://vpcc.church

# Expose /design-system on a deploy preview. Leave unset in production.
NEXT_PUBLIC_SHOW_DESIGN_SYSTEM=

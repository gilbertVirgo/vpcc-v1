{
	"name": "vpcc",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"lint:tokens": "node scripts/check-design-tokens.mjs",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"check": "npm run typecheck && npm run lint && npm run lint:tokens",
		"tokens:colors": "node scripts/generate-color-ramps.mjs"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"next": "^16.2.11",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0"
	},
	"allowScripts": {
		"sharp@0.34.5": true,
		"unrs-resolver@1.12.2": true
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/culori": "^4.0.1",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"culori": "^4.0.2",
		"eslint": "^9.39.5",
		"eslint-config-next": "^16.2.11",
		"postcss": "^8.5.22",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	}
}
